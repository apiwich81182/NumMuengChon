                      </td>
                      <td className="py-3 px-4 text-right text-rose-600">
                        {m.expense > 0 ? `฿${m.expense.toLocaleString()}` : "-"}
                      </td>
                      <td
                        className={`py-3 px-4 text-right font-bold ${
                          m.profit >= 0 ? "text-blue-600" : "text-rose-600"
                        }`}
                      >
                        ฿{m.profit.toLocaleString()}
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  );
}
