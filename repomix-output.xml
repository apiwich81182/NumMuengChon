                ) : (
                  breakdownList.map((m, idx) => (
                    <tr key={idx} className="hover:bg-slate-50 transition">
                      <td className="py-3 px-4 text-slate-800 font-semibold">
                        {period === "monthly" ? `วันที่ ${m.label}` : m.label}
